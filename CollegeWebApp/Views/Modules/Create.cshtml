@model CollegeWebApp.Models.Module
@{
    ViewData["Title"] = "Create Module";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card glass-card">
                <div class="card-header" style="background: rgba(23, 162, 184, 0.3); border-bottom: 1px solid rgba(255,255,255,0.1); color: #ffffff; border-radius: 16px 16px 0 0 !important; padding: 1.5rem;">
                    <h4 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i> Create New Module
                    </h4>
                </div>
                <div class="card-body" style="color: #ffffff; padding: 2rem;">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="StudentID" class="form-label fw-bold">
                                        <i class="fas fa-user-graduate me-1" style="color: #4b6cb7;"></i> Student
                                    </label>
                                    <select asp-for="StudentID" class="form-select" asp-items="ViewBag.StudentID" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #ffffff; border-radius: 8px;">
                                        <option value="">-- Select Student --</option>
                                    </select>
                                    <span asp-validation-for="StudentID" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="VenueID" class="form-label fw-bold">
                                        <i class="fas fa-building me-1" style="color: #28a745;"></i> Venue
                                    </label>
                                    <select asp-for="VenueID" class="form-select" asp-items="ViewBag.VenueID" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #ffffff; border-radius: 8px;">
                                        <option value="">-- Select Venue --</option>
                                    </select>
                                    <span asp-validation-for="VenueID" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Date" class="form-label fw-bold">
                                        <i class="fas fa-calendar me-1" style="color: #ffc107;"></i> Date
                                    </label>
                                    <input asp-for="Date" class="form-control" type="date" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #ffffff; border-radius: 8px;" />
                                    <span asp-validation-for="Date" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Time" class="form-label fw-bold">
                                        <i class="fas fa-clock me-1" style="color: #17a2b8;"></i> Time
                                    </label>
                                    <input asp-for="Time" class="form-control" type="time" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #ffffff; border-radius: 8px;" />
                                    <span asp-validation-for="Time" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-glass-info">
                                <i class="fas fa-save me-2"></i> Create Module
                            </button>
                            <a asp-action="Index" class="btn-glass-secondary">
                                <i class="fas fa-times me-2"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.10);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        overflow: hidden;
        color: #ffffff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 0.6rem 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #17a2b8 !important;
            box-shadow: 0 0 0 0.2rem rgba(23, 162, 184, 0.25) !important;
            background: rgba(255, 255, 255, 0.15) !important;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .form-control option, .form-select option {
            background: #2d3748;
            color: #ffffff;
        }

    .btn-glass-info {
        background: rgba(23, 162, 184, 0.6);
        border: 1px solid rgba(23, 162, 184, 0.3);
        color: #ffffff;
        padding: 0.6rem 1.5rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-glass-info:hover {
            background: rgba(23, 162, 184, 0.8);
            border-color: rgba(23, 162, 184, 0.6);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(23, 162, 184, 0.3);
        }

    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.10);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #ffffff;
        padding: 0.6rem 1.5rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-glass-secondary:hover {
            background: rgba(255, 255, 255, 0.20);
            border-color: rgba(255, 255, 255, 0.30);
            color: #ffffff;
            transform: translateY(-2px);
        }

    .alert-danger {
        background: rgba(220, 53, 69, 0.2);
        border: 1px solid rgba(220, 53, 69, 0.3);
        color: #ff6b7a;
        border-radius: 8px;
        padding: 1rem;
    }

    .text-danger {
        color: #ff6b7a !important;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}