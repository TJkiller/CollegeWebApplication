@model CollegeWebApp.Models.Module
@{
    ViewData["Title"] = "Module Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card glass-card">
                <div class="card-header" style="background: rgba(75, 108, 183, 0.3); border-bottom: 1px solid rgba(255,255,255,0.1); color: #ffffff; border-radius: 16px 16px 0 0 !important; padding: 1.5rem;">
                    <h4 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i> Module Details
                    </h4>
                </div>
                <div class="card-body" style="color: #ffffff; padding: 2rem;">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label class="form-label fw-bold" style="color: rgba(255,255,255,0.6);">
                                    <i class="fas fa-user-graduate me-1" style="color: #4b6cb7;"></i> Student
                                </label>
                                <p class="fs-5">
                                    <span class="badge-student">
                                        <i class="fas fa-user me-1"></i> @Html.DisplayFor(model => model.Student.StudentName)
                                    </span>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label class="form-label fw-bold" style="color: rgba(255,255,255,0.6);">
                                    <i class="fas fa-building me-1" style="color: #28a745;"></i> Venue
                                </label>
                                <p class="fs-5">
                                    <span class="badge-venue">
                                        <i class="fas fa-building me-1"></i> @Html.DisplayFor(model => model.Venue.VenueName)
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label class="form-label fw-bold" style="color: rgba(255,255,255,0.6);">
                                    <i class="fas fa-calendar me-1" style="color: #ffc107;"></i> Date
                                </label>
                                <p class="fs-5">
                                    <span class="badge-date">
                                        <i class="fas fa-calendar me-1"></i> @Model.Date?.ToString("dddd, dd MMMM yyyy")
                                    </span>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label class="form-label fw-bold" style="color: rgba(255,255,255,0.6);">
                                    <i class="fas fa-clock me-1" style="color: #17a2b8;"></i> Time
                                </label>
                                <p class="fs-5">
                                    <span class="badge-time">
                                        <i class="fas fa-clock me-1"></i> @Model.Time?.ToString(@"hh\:mm")
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="Edit" asp-route-id="@Model?.ModuleID" class="btn btn-glass-info">
                            <i class="fas fa-edit me-2"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn-glass-secondary">
                            <i class="fas fa-arrow-left me-2"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.10);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        overflow: hidden;
        color: #ffffff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .badge-student {
        background: rgba(75, 108, 183, 0.3);
        color: #4b6cb7;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 1rem;
        border: 1px solid rgba(75, 108, 183, 0.2);
    }

    .badge-venue {
        background: rgba(40, 167, 69, 0.3);
        color: #28a745;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 1rem;
        border: 1px solid rgba(40, 167, 69, 0.2);
    }

    .badge-date {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 1rem;
        border: 1px solid rgba(255, 193, 7, 0.15);
    }

    .badge-time {
        background: rgba(23, 162, 184, 0.2);
        color: #17a2b8;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 1rem;
        border: 1px solid rgba(23, 162, 184, 0.15);
    }

    .btn-glass-info {
        background: rgba(23, 162, 184, 0.6);
        border: 1px solid rgba(23, 162, 184, 0.3);
        color: #ffffff;
        padding: 0.6rem 1.5rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-glass-info:hover {
            background: rgba(23, 162, 184, 0.8);
            border-color: rgba(23, 162, 184, 0.6);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(23, 162, 184, 0.3);
        }

    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.10);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #ffffff;
        padding: 0.6rem 1.5rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-glass-secondary:hover {
            background: rgba(255, 255, 255, 0.20);
            border-color: rgba(255, 255, 255, 0.30);
            color: #ffffff;
            transform: translateY(-2px);
        }
</style>